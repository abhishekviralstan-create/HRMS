# If you have TWO machines (one for IN punches, one for OUT punches), fill both of these
# and leave DEVICE_IP below empty/unused:
DEVICE_IN_IP=192.168.18.211
DEVICE_OUT_IP=192.168.18.212

# If you only have ONE machine, ignore the two above and use this instead:
# DEVICE_IP=192.168.18.211

# Check the device's Communication screen for the real value (ours reported 5005, not the usual 4370)
DEVICE_PORT=5005

# Socket timeout / reply timeout in ms - raise these if the device is slow to respond
DEVICE_TIMEOUT=10000
DEVICE_INPORT=5200

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/fingerprint_sync

# Dashboard/API port and device polling interval. 10-15 seconds gives near-live punches.
APP_PORT=3001
HOST_PC_PORT=5005
DEVICE_MODE=push
SYNC_INTERVAL_MS=15000

# Dashboard login (set real values only in .env; never commit passwords)
LOGIN_EMAIL=admin@example.com
LOGIN_PASSWORD=change-this-password
# Optional session lifetime; default is 12 hours
SESSION_TTL_MS=43200000
